    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-03T16:51:15.816694Z\",\n",
    "     \"start_time\": \"2025-09-03T16:51:15.774806Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"import warnings\\n\",\n",
    "    \"\\n\",\n",
    "    \"warnings.filterwarnings(\\\"ignore\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"from common import EVALUATE_ALL_CSVS\\n\",\n",
    "    \"\\n\",\n",
    "    \"model = \\\"EGFR_MAPK__logobs\\\"\\n\",\n",
    "    \"data = \\\"dream_cytof\\\"\\n\",\n",
    "    \"filename = \\\"evaluate_all_figure1c\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = pd.read_csv(EVALUATE_ALL_CSVS.format(model=model, data=data, filename=filename), index_col=0)\\n\",\n",
    "    \"df[\\\"N_features\\\"] = df[\\\"N_features\\\"] = df[\\\"features\\\"].str.extract(r\\\"RFE_(\\\\d+)_permute\\\")\"\n",
    "   ],\n",
    "   \"id\": \"163cf1b3d2f4dc33\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 1\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-03T16:51:16.278671Z\",\n",
    "     \"start_time\": \"2025-09-03T16:51:16.274657Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"val_df = df[df.dataset == \\\"val\\\"]\\n\",\n",
    "    \"dmm_val_df = val_df[val_df.ref == \\\"DMM\\\"]\\n\",\n",
    "    \"# val_df.features.fillna(\\\"None\\\", inplace=True)\\n\",\n",
    "    \"dmm_val_df.N_features = dmm_val_df.N_features.astype(\\\"int\\\")\"\n",
    "   ],\n",
    "   \"id\": \"5aea57c621ab35e8\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 2\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# Number of features\",\n",
    "   \"id\": \"df29aaa7634d8bf6\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-03T16:51:17.470708Z\",\n",
    "     \"start_time\": \"2025-09-03T16:51:16.763113Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"palette = {\\n\",\n",
    "    \"    \\\"cytof_init\\\": \\\"cyan\\\",\\n\",\n",
    "    \"    \\\"proteomics\\\": \\\"gold\\\",\\n\",\n",
    "    \"    \\\"transcriptomics\\\": \\\"green\\\",\\n\",\n",
    "    \"    \\\"multimodal\\\": \\\"magenta\\\",\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"g = sns.FacetGrid(\\n\",\n",
    "    \"    dmm_val_df,\\n\",\n",
    "    \"    col=\\\"context\\\",\\n\",\n",
    "    \"    col_order=palette.keys()\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"g.map_dataframe(\\n\",\n",
    "    \"    sns.lineplot,\\n\",\n",
    "    \"    x=\\\"N_features\\\",\\n\",\n",
    "    \"    y=\\\"rmse\\\",\\n\",\n",
    "    \"    marker='o',\\n\",\n",
    "    \"    hue=\\\"context\\\",\\n\",\n",
    "    \"    palette=palette\\n\",\n",
    "    \")\"\n",
    "   ],\n",
    "   \"id\": \"ceded28a95f8fd6b\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<seaborn.axisgrid.FacetGrid at 0x16b2d9d50>\"\n",
    "      ]\n",
    "     },\n",
    "     \"execution_count\": 3,\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"execute_result\"\n",
    "    },\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1200x300 with 4 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\"\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 3\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-03T16:51:17.487536Z\",\n",
    "     \"start_time\": \"2025-09-03T16:51:17.485074Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from scipy import stats\\n\",\n",
    "    \"\\n\",\n",
    "    \"def kruskal_wallis_groups(df, target_metric, group_metric, context_metric=\\\"context\\\"):\\n\",\n",
    "    \"    for context in df[context_metric].unique():\\n\",\n",
    "    \"        context_data = df[df[context_metric] == context]\\n\",\n",
    "    \"        groups = [group[target_metric].values for _, group in context_data.groupby(group_metric)]\\n\",\n",
    "    \"        stat, p_value = stats.kruskal(*groups)\\n\",\n",
    "    \"        print(f\\\"Context/Group: {context} - Kruskal-Wallis H-test: H-statistic={stat:.2f}, p-value={p_value:.4f}, significant? {p_value < 0.05}\\\")\"\n",
    "   ],\n",
    "   \"id\": \"41c93627e85dd029\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 4\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-03T16:51:18.893900Z\",\n",
    "     \"start_time\": \"2025-09-03T16:51:18.885789Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"kruskal_wallis_groups(\\n\",\n",
    "    \"    dmm_val_df[dmm_val_df.N_features >=10],\\n\",\n",
    "    \"    \\\"rmse\\\",\\n\",\n",
    "    \"    \\\"N_features\\\",\\n\",\n",
    "    \"    \\\"context\\\"\\n\",\n",
    "    \")\"\n",
    "   ],\n",
    "   \"id\": \"127dde5ae294e9f5\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Context/Group: proteomics - Kruskal-Wallis H-test: H-statistic=25.12, p-value=0.0000, significant? True\\n\",\n",
    "      \"Context/Group: transcriptomics - Kruskal-Wallis H-test: H-statistic=8.88, p-value=0.0641, significant? False\\n\",\n",
    "      \"Context/Group: multimodal - Kruskal-Wallis H-test: H-statistic=34.80, p-value=0.0000, significant? True\\n\",\n",
    "      \"Context/Group: cytof_init - Kruskal-Wallis H-test: H-statistic=3.10, p-value=0.5411, significant? False\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 5\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"Not significant for cytof_init or transcriptomics. multimodal only gets worse. proteomics is the only context where there seems to be an honest and significant benefit in using more features - is it just that feature selection cannot find relevant features at all and this increases the chances of finding remotely useful ones?\",\n",
    "   \"id\": \"a2bd9b41e37be563\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-01T18:11:52.082534Z\",\n",
    "     \"start_time\": \"2025-09-01T18:11:52.081111Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
