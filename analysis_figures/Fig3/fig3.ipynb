    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# Let's restrict to `__logobs_tegr_aggavg` and compare with baselines and regressors\",\n",
    "   \"id\": \"55a97d62692b8313\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-05T18:10:25.487065Z\",\n",
    "     \"start_time\": \"2025-09-05T18:10:25.332453Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"g = sns.FacetGrid(\\n\",\n",
    "    \"    val_df[val_df.model == \\\"EGFR_MAPK__logobs_tegfr_aggavg\\\"],\\n\",\n",
