    "    \"    y=\\\"ref\\\",\\n\",\n",
    "    \"    x=\\\"rmse\\\",\\n\",\n",
    "    \"    order=[\\\"avg_model\\\", \\\"sample\\\", \\\"linreg\\\", \\\"lasso\\\", \\\"elasticnet\\\", \\\"DMM\\\"],\\n\",\n",
    "    \")\"\n",
    "   ],\n",
    "   \"id\": \"a8250befa429646e\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<seaborn.axisgrid.FacetGrid at 0x319b07af0>\"\n",
