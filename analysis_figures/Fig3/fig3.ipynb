    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"# It seems like the mean Jaccard across samples and jobs is considerbaly lower in the case of tEGFR model compared to previous fEGFR with tEGFR levels provided as input features (from 0.55 down to 0.36). Mean Spearman correlation is also down considerably, and mean distance correlation is worse as well...what is going on?\\n\",\n",
    "    \"- In particular, we see that BT20 is doing badly consistency-wise compared to the previous models (figure 2a).\\n\",\n",
    "    \"- We can also see that the embeddings do not seem to cluster according to / align with luminal/basal subtype anymore, since the EGFR information has been embedded into the mechanistic model...\"\n",
    "   ],\n",
    "   \"id\": \"bb135f91b1ea7cd9\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-01T16:59:41.516050Z\",\n",
    "     \"start_time\": \"2025-09-01T16:59:41.513676Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": \"\",\n",
    "   \"id\": \"4161e331799585bf\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# Trying to make sense of parameter deviations - PCA-ing across jobs/multistarts and investigating differences between train/val on val cell-lines\",\n",
    "   \"id\": \"73a819a7e5e55128\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-05T18:29:39.318021Z\",\n",
    "     \"start_time\": \"2025-09-05T18:29:39.079411Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import itertools as itt\\n\",\n",
    "    \"from common import evaluations_dir\\n\",\n",
    "    \"from sklearn.decomposition import PCA\\n\",\n",
    "    \"\\n\",\n",
    "    \"par_dev_df = pd.concat(\\n\",\n",
    "    \"    [\\n\",\n",
    "    \"        pd.read_csv(evaluations_dir / model / data/ \\\"param_devs_figure3.csv\\\", index_col=0).assign(model=model)\\n\",\n",
    "    \"        for model in PATHWAYS_3\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"not_param_cols = [\\n\",\n",
    "    \"    \\\"cell_line\\\", \\\"context\\\", \\\"model\\\", \\\"features\\\", \\\"samples\\\", \\\"dataset\\\", \\\"l1reg_inflater_output\\\", \\\"inflater_output_reg_epoch\\\", \\\"recon_loss\\\", \\\"inflater_bound\\\", \\\"n_epoch\\\", \\\"job\\\"\\n\",\n",
    "    \"]\\n\",\n",
    "    \"param_cols = [col for col in par_dev_df.columns if col not in not_param_cols]\\n\",\n",
    "    \"\\n\",\n",
    "    \"median_par_dev_df = par_dev_df.groupby([\\\"context\\\", \\\"features\\\", \\\"cell_line\\\", \\\"samples\\\"])[param_cols].median().reset_index()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def pca_param_devs(par_dev_df):\\n\",\n",
    "    \"    results_dfs = []\\n\",\n",
    "    \"    for ctxt, split in itt.product(par_dev_df.context.unique(), par_dev_df.samples.unique()):\\n\",\n",
    "    \"        sub_df = par_dev_df[(par_dev_df.context == ctxt) & (par_dev_df.samples == split)]\\n\",\n",
    "    \"        # Compute median across job/multistart\\n\",\n",
    "    \"        sub_df = sub_df.groupby([\\\"context\\\", \\\"samples\\\", \\\"cell_line\\\"])[param_cols].median().reset_index()\\n\",\n",
    "    \"        sub_df.set_index(\\\"cell_line\\\", inplace=True)\\n\",\n",
    "    \"        pca = PCA(n_components=2)\\n\",\n",
    "    \"        temp_res = pd.DataFrame(\\n\",\n",
    "    \"            pca.fit_transform(sub_df[param_cols]),\\n\",\n",
    "    \"            sub_df.index,\\n\",\n",
    "    \"            columns=[\\\"PC1\\\", \\\"PC2\\\"]\\n\",\n",
    "    \"        ).assign(context=ctxt, samples=split)\\n\",\n",
    "    \"        results_dfs.append(temp_res)\\n\",\n",
    "    \"    return pd.concat(results_dfs)\\n\",\n",
    "    \"\\n\",\n",
    "    \"pca_param_df = pd.concat(\\n\",\n",
    "    \"    [\\n\",\n",
    "    \"        pca_param_devs(par_dev_df[par_dev_df.model == model]).assign(model=model)\\n\",\n",
    "    \"        for model in PATHWAYS_3\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \")\"\n",
    "   ],\n",
    "   \"id\": \"426891f342178ce7\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 59\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-05T18:30:07.711925Z\",\n",
    "     \"start_time\": \"2025-09-05T18:30:06.684765Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# Add a new column for marker style\\n\",\n",
    "    \"pca_param_df[\\\"marker_style\\\"] = pca_param_df.apply(\\n\",\n",
    "    \"    lambda row: \\\"val\\\" if row.name[1:] == row[\\\"samples\\\"] else \\\"train\\\",\\n\",\n",
    "    \"    axis=1\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Define marker mapping\\n\",\n",
    "    \"marker_dict = {\\\"val\\\": \\\"X\\\", \\\"train\\\": \\\"o\\\"}  # X for validation, circle otherwise\\n\",\n",
    "    \"\\n\",\n",
    "    \"g = sns.FacetGrid(\\n\",\n",
    "    \"    pca_param_df[pca_param_df.index.isin([\\\"cMCF7\\\", \\\"cBT20\\\", \\\"cHCC1500\\\", \\\"cEVSAT\\\", \\\"cUACC3199\\\"])],\\n\",\n",
    "    \"    row=\\\"context\\\",\\n\",\n",
    "    \"    row_order=[\\\"cytof_init\\\", \\\"cytof_init_plus_lb\\\", \\\"cytof_init_plus_intr\\\"],\\n\",\n",
    "    \"    col=\\\"model\\\",\\n\",\n",
    "    \"    col_order=[\\\"EGFR_MAPK__logobs\\\", \\\"EGFR_MAPK__logobs_tegfr_aggavg\\\", \\\"EGFR_MAPK__logobs_tegfr_aggavg_pobs\\\"],\\n\",\n",
    "    \"    sharex=False,\\n\",\n",
    "    \"    sharey=False\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"g.map_dataframe(\\n\",\n",
    "    \"    sns.scatterplot,\\n\",\n",
    "    \"    x=\\\"PC1\\\",\\n\",\n",
    "    \"    y=\\\"PC2\\\",\\n\",\n",
    "    \"    hue=\\\"cell_line\\\",\\n\",\n",
    "    \"    style=\\\"marker_style\\\",        # use the new column for marker\\n\",\n",
    "    \"    markers=marker_dict,         # assign specific markers\\n\",\n",
    "    \"    hue_order=[\\\"cMCF7\\\", \\\"cBT20\\\", \\\"cHCC1500\\\", \\\"cEVSAT\\\", \\\"cUACC3199\\\"]\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.legend(bbox_to_anchor=(1.05, 1), loc=2, borderaxespad=0.)\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
