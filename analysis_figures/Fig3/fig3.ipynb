    "    \"\\n\",\n",
    "    \"# Compute per (split vs other_split) comparisons for each validation cell\\n\",\n",
    "    \"splits = [\\\"MCF7\\\", \\\"BT20\\\", \\\"HCC1500\\\", \\\"EVSAT\\\", \\\"UACC3199\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"summaries = []\\n\",\n",
    "    \"for model, (context, _) in itt.product(PATHWAYS_3, CONTEXTS_FEATURES_3):\\n\",\n",
    "    \"    print(model, context)\\n\",\n",
    "    \"    per_pair = compute_validation_neighborhood_consistency(\\n\",\n",
    "    \"        {split: pca_embeddings_dict[model][(pca_embeddings_dict[model][\\\"samples\\\"] == split) & (pca_embeddings_dict[model].context == context)][[\\\"L1\\\", \\\"L2\\\"]] for split in splits},\\n\",\n",
    "    \"        {split: \\\"c\\\"+split for split in splits},\\n\",\n",
    "    \"        n_neighbors=5,      # set N here\\n\",\n",
    "    \"        metric=\\\"euclidean\\\",  # or \\\"cosine\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
