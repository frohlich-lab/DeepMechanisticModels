    "   \"execution_count\": 8\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-05T18:13:05.096159Z\",\n",
    "     \"start_time\": \"2025-09-05T18:13:05.093229Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from scipy import stats\\n\",\n",
    "    \"\\n\",\n",
    "    \"def kruskal_wallis_groups(df, target_metric, group_metric):\\n\",\n",
    "    \"    num_contexts = int(len(df['context'].unique()))\\n\",\n",
    "    \"    for context in df['context'].unique():\\n\",\n",
    "    \"        context_data = df[df['context'] == context]\\n\",\n",
    "    \"        groups = [group[target_metric].values for _, group in context_data.groupby(group_metric)]\\n\",\n",
    "    \"        stat, p_value = stats.kruskal(*groups)\\n\",\n",
    "    \"        print(f\\\"Context: {context} - Kruskal-Wallis H-test: H-statistic={stat:.2f}, p-value={p_value:.4f}; < 0.05/{num_contexts}={0.05/num_contexts}?: {p_value < 0.05/num_contexts}\\\")\"\n",
    "   ],\n",
    "   \"id\": \"b255add22199aa7a\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 14\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# There is a statistically significant difference (improvement) from `__logobs` to `__logobs_tegfr_aggavg`, but not to `__logobs_tegfr_aggavg_pobs`\",\n",
    "   \"id\": \"50940bdf59f8b86\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-05T18:13:05.735281Z\",\n",
    "     \"start_time\": \"2025-09-05T18:13:05.729225Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"kruskal_wallis_groups(\\n\",\n",
    "    \"    val_df[(val_df.ref.isin([\\\"DMM\\\"])) & (val_df.model.isin([\\\"EGFR_MAPK__logobs\\\", \\\"EGFR_MAPK__logobs_tegfr_aggavg\\\"]))],\\n\",\n",
    "    \"    \\\"rmse\\\",\\n\",\n",
    "    \"    \\\"model\\\"\\n\",\n",
    "    \")\"\n",
    "   ],\n",
    "   \"id\": \"d1af9f0213379795\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Context: cytof_init_plus_lb - Kruskal-Wallis H-test: H-statistic=4.54, p-value=0.0332; < 0.05/3=0.016666666666666666?: False\\n\",\n",
    "      \"Context: cytof_init_plus_intr - Kruskal-Wallis H-test: H-statistic=0.34, p-value=0.5625; < 0.05/3=0.016666666666666666?: False\\n\",\n",
    "      \"Context: cytof_init - Kruskal-Wallis H-test: H-statistic=6.40, p-value=0.0114; < 0.05/3=0.016666666666666666?: True\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 15\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# `cytof_init` improves significantly going from `__logobs` to `__logobs_tegfr_aggavg` (even with multiple-testing correction)\",\n",
    "   \"id\": \"a0d0a2a3083fab9c\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-05T18:14:35.179109Z\",\n",
    "     \"start_time\": \"2025-09-05T18:14:35.173659Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"groups = [\\n\",\n",
    "    \"    val_df[(val_df.ref.isin([\\\"DMM\\\"])) & (val_df.model.isin([\\\"EGFR_MAPK__logobs\\\",]))].sort_values(by=[\\\"context\\\", \\\"samples\\\", \\\"job\\\"]).rmse.values,\\n\",\n",
    "    \"    val_df[(val_df.ref.isin([\\\"DMM\\\"])) & (val_df.model.isin([\\\"EGFR_MAPK__logobs_tegfr_aggavg\\\",]))].sort_values(by=[\\\"context\\\", \\\"samples\\\", \\\"job\\\"]).rmse.values,\\n\",\n",
    "    \"]\\n\",\n",
    "    \"stat, p = stats.wilcoxon(*groups, alternative=\\\"two-sided\\\")\\n\",\n",
    "    \"print(f\\\"Wilcoxon signed-rank: W={stat}, p={p:.4g}\\\")\"\n",
    "   ],\n",
    "   \"id\": \"5584f23a9839974\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Wilcoxon signed-rank: W=2577.0, p=7.075e-09\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 17\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# Overall, all contexts considered, there is a stat. significant improvement between `__logobs` and `__logobs_tegfr_aggavg`\",\n",
    "   \"id\": \"c354a12b9421f0e0\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
