    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# Add Kruskal-Wallis stat tests\",\n",
    "   \"id\": \"e881a08184a13daf\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-03T16:46:03.439576Z\",\n",
    "     \"start_time\": \"2025-09-03T16:46:03.436393Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def p_to_stars(p):\\n\",\n",
    "    \"    if p < 0.001:\\n\",\n",
    "    \"        return \\\"***\\\"\\n\",\n",
    "    \"    elif p < 0.01:\\n\",\n",
    "    \"        return \\\"**\\\"\\n\",\n",
    "    \"    elif p < 0.05:\\n\",\n",
    "    \"        return \\\"*\\\"\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        return \\\"ns\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def groupwise_kw(df, xcol, ycol, groupcol):\\n\",\n",
    "    \"    results = {}\\n\",\n",
    "    \"    for g, sub in df.groupby(groupcol):\\n\",\n",
    "    \"        groups = [ys[ycol].values for _, ys in sub.groupby(xcol)]\\n\",\n",
    "    \"        if len(groups) > 1:\\n\",\n",
    "    \"            stat, p = stats.kruskal(*groups)\\n\",\n",
    "    \"            results[g] = p\\n\",\n",
    "    \"    return results\"\n",
    "   ],\n",
    "   \"id\": \"93a4887598a09ffc\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 14\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-03T16:46:04.849457Z\",\n",
    "     \"start_time\": \"2025-09-03T16:46:03.973313Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"fig, axes = plt.subplots(2, 2, figsize=(10, 10))\\n\",\n",
    "    \"\\n\",\n",
    "    \"param_central_values = {\\n\",\n",
    "    \"    \\\"n_hidden\\\": 2,\\n\",\n",
    "    \"    \\\"depth\\\": 0,\\n\",\n",
    "    \"    \\\"log_l1reg_inflater_output\\\": -4,\\n\",\n",
    "    \"    \\\"log_l2reg_inflater_output\\\": -10,  # ~0\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i, param in enumerate(param_central_values.keys()):\\n\",\n",
    "    \"    mask = np.ones(len(val_df), dtype=bool)\\n\",\n",
    "    \"    for parameter, value in param_central_values.items():\\n\",\n",
    "    \"        if parameter == param:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        mask &= val_df[parameter] == value\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax = axes.flat[i]\\n\",\n",
    "    \"    sns.lineplot(\\n\",\n",
    "    \"        data=val_df[mask],\\n\",\n",
    "    \"        x=param, y=\\\"rmse\\\",\\n\",\n",
    "    \"        hue=\\\"group\\\",\\n\",\n",
    "    \"        palette=palette,\\n\",\n",
    "    \"        marker=\\\"o\\\",\\n\",\n",
    "    \"        legend=False,   # suppress subplot legends\\n\",\n",
    "    \"        ax=ax,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    ax.set_title(f\\\"Varying {param}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    dsub = val_df[mask]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    kw_results = groupwise_kw(dsub, xcol=param, ycol=\\\"rmse\\\", groupcol=\\\"group\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for g, p in kw_results.items():\\n\",\n",
    "    \"        star = p_to_stars(p)\\n\",\n",
    "    \"        x_pos = dsub[param].max() + 0.1\\n\",\n",
    "    \"        y_pos = dsub.loc[dsub[\\\"group\\\"] == g, \\\"rmse\\\"].mean()\\n\",\n",
    "    \"        ax.text(\\n\",\n",
    "    \"            x_pos,\\n\",\n",
    "    \"            y_pos,\\n\",\n",
    "    \"            star,\\n\",\n",
    "    \"            color=palette[g],\\n\",\n",
    "    \"            fontsize=12,\\n\",\n",
    "    \"            ha=\\\"left\\\", va=\\\"bottom\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- build one shared legend using palette keys (keeps your order) ---\\n\",\n",
    "    \"legend_labels = [group for group in list(palette.keys()) if group != \\\"multimodal_RFE_10_permute\\\"]\\n\",\n",
    "    \"legend_handles = [Line2D([0], [0], marker='o', linestyle='-',\\n\",\n",
    "    \"                         color=palette[label], label=label)\\n\",\n",
    "    \"                  for label in legend_labels]\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig.legend(legend_handles, legend_labels, title=\\\"group\\\",\\n\",\n",
    "    \"           bbox_to_anchor=(1.05, 1), loc=\\\"upper left\\\")\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
    "   \"id\": \"37244edfa7abdbdc\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1000x1000 with 4 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\"\n",
    "    }\n",
    "   ],\n",
