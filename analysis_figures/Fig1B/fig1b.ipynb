    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# No significant effect from `l2_reg_inflater_output` either...\",\n",
    "   \"id\": \"e318082184dca6fd\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# As best_RFE_10_permute outperforms RFE_10_permute for multimodal, we can subset to that feature selection strategy only and rather look at sample split\",\n",
    "   \"id\": \"94fec376322e45cc\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-03T16:46:00.951220Z\",\n",
    "     \"start_time\": \"2025-09-03T16:46:00.947934Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"val_df = val_df[~((val_df[\\\"context\\\"] == \\\"multimodal\\\") &\\n\",\n",
    "    \"                  (val_df[\\\"features\\\"] == \\\"RFE_10_permute\\\"))]\"\n",
    "   ],\n",
    "   \"id\": \"a7394161d083a963\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 12\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-03T16:46:01.577376Z\",\n",
    "     \"start_time\": \"2025-09-03T16:46:01.575945Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": \"\",\n",
    "   \"id\": \"f2c3cf36b1995f77\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
