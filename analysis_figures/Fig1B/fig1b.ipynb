    "     \"start_time\": \"2025-09-03T16:46:02.023479Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from matplotlib.lines import Line2D\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(2, 2, figsize=(10, 10))\\n\",\n",
    "    \"\\n\",\n",
    "    \"param_central_values = {\\n\",\n",
    "    \"    \\\"n_hidden\\\": 2,\\n\",\n",
    "    \"    \\\"depth\\\": 0,\\n\",\n",
    "    \"    \\\"log_l1reg_inflater_output\\\": -4,\\n\",\n",
    "    \"    \\\"log_l2reg_inflater_output\\\": -10,  # ~0\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i, param in enumerate(param_central_values.keys()):\\n\",\n",
    "    \"    mask = np.ones(len(val_df), dtype=bool)\\n\",\n",
    "    \"    for parameter, value in param_central_values.items():\\n\",\n",
    "    \"        if parameter == param:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        mask &= val_df[parameter] == value\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax = axes.flat[i]\\n\",\n",
    "    \"    sns.lineplot(\\n\",\n",
    "    \"        data=val_df[mask],\\n\",\n",
    "    \"        x=param, y=\\\"rmse\\\",\\n\",\n",
    "    \"        hue=\\\"group\\\",\\n\",\n",
    "    \"        palette=palette,\\n\",\n",
    "    \"        marker=\\\"o\\\",\\n\",\n",
    "    \"        legend=False,   # suppress subplot legends\\n\",\n",
    "    \"        ax=ax,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    ax.set_title(f\\\"Varying {param}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- build one shared legend using palette keys (keeps your order) ---\\n\",\n",
    "    \"legend_labels = [group for group in list(palette.keys()) if group != \\\"multimodal_RFE_10_permute\\\"]\\n\",\n",
    "    \"legend_handles = [Line2D([0], [0], marker='o', linestyle='-',\\n\",\n",
    "    \"                         color=palette[label], label=label)\\n\",\n",
    "    \"                  for label in legend_labels]\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig.legend(legend_handles, legend_labels, title=\\\"group\\\",\\n\",\n",
    "    \"           bbox_to_anchor=(1.05, 1), loc=\\\"upper left\\\")\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
